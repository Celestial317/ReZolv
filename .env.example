# yugabytedb is the compose service name; use localhost when the server runs outside Docker
DATABASE_URL=postgresql://yugabyte:yugabyte@localhost:5433/yugabyte
JWT_SECRET=change-me
# "*" lets the phone app and the dashboard call the API from any device on the Wi-Fi
CORS_ORIGINS=*

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Rate-limit protection for the shared key
GEMINI_RPM=12
GEMINI_EMBED_RPM=60
GEMINI_DAILY_BUDGET=1000

VULTR_S3_ENDPOINT=https://del1.vultrobjects.com
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
BUCKET_VOICE=rezolv-voice
BUCKET_PHOTOS=rezolv-photos

MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
# UUID from `datapack_list` (not the datapack's name)
MEKO_DATAPACK_ID=

# Optional (Solana devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
